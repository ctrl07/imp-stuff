{
  "manifest_version": 3,
  "name": "Imp Stuff",
  "version": "0.0.1",
  "description": "",
  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "commands"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [""],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Imp Stuff"
  },
  "side_panel": {
    "default_path": ""
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open side panel"
    }
  }
}