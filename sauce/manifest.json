{
  "manifest_version": 3,
  "name": "Imp Stuff",
  "version": "0.5.0",
  "description": "Feel free to share any feedback!",

  "permissions": [
    "contextMenus",
    "storage",
    "sidePanel",
    "commands"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bootstrap.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "Imp Stuff"
  },

  "side_panel": {
    "default_path": "features/website-inspector/index.html"
  },

  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open side panel"
    }
  }
}